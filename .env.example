# Manipuri AI — environment variable template.
# Copy to `.env` and fill in real values. NEVER commit a filled-in copy.
# Names only here — no values, no secrets.

# ---------------------------------------------------------------------------
# Supabase — client (VITE_* is injected into the browser bundle, so these must
# only ever be the publishable/anon key and the public project URL).
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Supabase — server. SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely: it must
# be set as a server-side secret only, never with a VITE_ prefix.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI gateway (server-side only). Chat, image generation and transcription all
# refuse to start without one of these two — LOVABLE_API_KEY is preferred and
# GEMINI_API_KEY is the fallback.
# ---------------------------------------------------------------------------
LOVABLE_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Payments (server-side only). The client receives key_id from the server when
# an order is created; it is never read from the browser environment.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Web search (server-side only). Optional: `firecrawlSearch` returns null when
# this is absent, so chat answers without web grounding and nothing else breaks.
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY=
