{
  "version": 1,
  "sdk_version": "0.26.3",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://juujypcbxguekiflhkns.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "manipuriai",
      "version": "0.1.0",
      "title": "ManipuriAi"
    },
    "tools": [
      {
        "name": "list_chats",
        "title": "List chats",
        "description": "List the signed-in user's Manipuri AI conversations, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "How many chats to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_chat_messages",
        "title": "Get chat messages",
        "description": "Read the messages of one of the signed-in user's Manipuri AI conversations.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "chat_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The chat id returned by list_chats."
            },
            "limit": {
              "default": 50,
              "description": "Maximum messages to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "chat_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_messages",
        "title": "Search messages",
        "description": "Search across the signed-in user's Manipuri AI chat history for a phrase.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Text to look for inside message content."
            },
            "limit": {
              "default": 20,
              "description": "Maximum matches to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_chat",
        "title": "Create chat",
        "description": "Create a new Manipuri AI conversation for the signed-in user, optionally seeded with a first user message.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Title of the new conversation."
            },
            "first_message": {
              "description": "Optional first user message stored in the new chat.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_profile",
        "title": "Get profile",
        "description": "Get the signed-in user's Manipuri AI profile, plan and preferred language.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
